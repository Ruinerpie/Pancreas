# =======================================================================
# Pancreas - Comprehensive Security & Production .gitignore
# Prevents accidental upload of secrets, caches, binaries & user data
# =======================================================================

# -----------------------------------------------------------------------
# 1. SECURITY & SENSITIVE CREDENTIALS (NEVER LEAK TO GITHUB)
# -----------------------------------------------------------------------
# Environment variables & secrets
.env
.env.*
*.env

# Keystores, signing keys, and certificates
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.pk8
*.asc
secring.gpg
secring.skr

# Sensitive tokens, credentials & private configs
credentials/
secrets/
*.token
*token*.json
*token*.txt

# -----------------------------------------------------------------------
# 2. GRADLE & BUILD SYSTEM OUTPUTS
# -----------------------------------------------------------------------
.gradle/
build/
bin/
out/
target/
.loom-cache/
.loom/

# Java compilation artifacts & jars (whitelist gradle wrapper)
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.nar

# -----------------------------------------------------------------------
# 3. MINECRAFT RUNTIME & USER DATA (SAVED GAMES, TOKENS, CONFIGS)
# -----------------------------------------------------------------------
run/
crash-reports/
logs/
screenshots/
replay_recordings/
*.log
*.log.gz

# Minecraft client account & server cache files
usercache.json
launcher_accounts.json
servers.dat
servers.dat_old

# -----------------------------------------------------------------------
# 4. CRASH DUMPS & JVM PROFILING ARTIFACTS
# -----------------------------------------------------------------------
*.hprof
hs_err_pid*
replay_pid*

# -----------------------------------------------------------------------
# 5. IDEs & EDITORS
# -----------------------------------------------------------------------
# JetBrains / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Visual Studio Code
.vscode/
*.code-workspace

# Eclipse
.classpath
.project
.settings/

# Sublime Text & others
*.sublime-project
*.sublime-workspace

# AI Agent & Assistant local caches
.agents/

# -----------------------------------------------------------------------
# 6. LOCAL BACKUPS & MAPPINGS CACHES
# -----------------------------------------------------------------------
Pancreas Backup/
*Backup*/
*backup*/
mappings.tiny

# -----------------------------------------------------------------------
# 7. OPERATING SYSTEM ARTIFACTS & TEMPORARY FILES
# -----------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Editor backup / swap files
*~
*.bak
*.old
*.swp
*.swo
*.tmp
